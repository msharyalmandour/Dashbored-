# انسخ هذا الملف إلى .env.local وعبّئ القيم — لا ترفع .env.local إلى Git.

# Supabase — من project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# مفتاح سري، للاستخدام في الخادم فقط (API routes / admin) — لا تعرضه للمتصفح
SUPABASE_SERVICE_ROLE_KEY=

# Tap Payments — من tap dashboard بعد تفعيل الحساب برخصة العمل الحر
TAP_SECRET_KEY=
NEXT_PUBLIC_TAP_PUBLISHABLE_KEY=
TAP_WEBHOOK_SECRET=

# رابط الموقع (لروابط إعادة التوجيه بعد الدفع)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
